<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Terminal sessions run as child processes, which Android 12+ kills once
         the app is cached. A foreground service is the only mitigation an app
         can apply to itself; see terminal/TerminalService.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Only so the service can say why it is running; denial costs the
         notification, not the protection. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConquestCodeByEyed">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection"
            android:label="@string/app_name"
            android:theme="@style/Theme.ConquestCodeByEyed"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask=false: swiping the app out of Recents must not kill a
             running build. The notification's "Stop all" action is how a
             session is ended from outside the app. -->
        <service
            android:name=".terminal.TerminalService"
            android:exported="false"
            android:stopWithTask="false" />
    </application>

</manifest>