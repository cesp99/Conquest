<?xml version="1.0" encoding="utf-8"?>
<!--
  Additions specific to the `full` flavour, which carries the Debian userland.

  INTERNET is here rather than in the main manifest because the `play`
  flavour has no userland to download and no other reason to touch the
  network. Nothing in this app phones home; see the privacy section of
  README.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
